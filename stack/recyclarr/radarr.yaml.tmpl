radarr:
  yamsplus_radarr:
    base_url: http://radarr:7878
    api_key: !secret radarr_api_key
    delete_old_custom_formats: true
    media_naming:
      folder: jellyfin-tmdb
      movie:
        rename: true
        standard: jellyfin-tmdb
    quality_definition:
      type: movie
    quality_profiles:
{{- if hasProfile .Quality.Movies.Profiles "1080p" }}
      - trash_id: 9ca12ea80aa55ef916e3751f4b874151
        name: YAMS+ 1080p
{{- end }}
{{- if hasProfile .Quality.Movies.Profiles "2160p" }}
      - trash_id: fd161a61e3ab826d3a22d53f935696dd
        name: YAMS+ 2160p
{{- end }}
    custom_formats:
      - trash_ids:
          - 923b6abef9b17f937fab56cfcf89e1f1 # DV without HDR fallback
        assign_scores_to:
{{- range .Quality.Movies.Profiles }}
          - name: YAMS+ {{ . }}
            score: -10000
{{- end }}
